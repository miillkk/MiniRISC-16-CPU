{"kind":"textbox","id":"sh/9wnqhczy","slideIndex":1,"position":{"left":82,"top":378,"width":525,"height":100},"name":"矩形 10","text":"wire cpu_rst = rst | load_mode;\nassign uart_tx = load_mode\n    ? loader_uart_tx : cpu_uart_tx;","geometry":"rect","lineWidth":0,"style":{"fontSize":21,"typeface":"Arial","color":"#F5F8FC","alignment":"left"}}
