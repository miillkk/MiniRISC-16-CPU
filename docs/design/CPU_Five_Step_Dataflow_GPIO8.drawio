<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net">
  <diagram id="five-steps" name="Five functional steps">
    <mxGraphModel page="1" pageWidth="1740" pageHeight="1530" grid="1" gridSize="10">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="cpu" value="CPU CORE boundary — Controller + Datapath" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;fontSize=17;fontFamily=Arial;verticalAlign=top;spacingTop=12;fontStyle=1;fontSize=21;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="210" width="1670" height="840" />
        </mxCell>
        <mxCell id="stage0" value="1  IF — Fetch" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#e0f2fe;strokeColor=#475569;strokeWidth=2;fontSize=17;fontFamily=Arial;verticalAlign=top;spacingTop=12;fontStyle=1;fontSize=21;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="275" width="310" height="650" />
        </mxCell>
        <mxCell id="stage1" value="2  ID — Decode / Read" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ede9fe;strokeColor=#475569;strokeWidth=2;fontSize=17;fontFamily=Arial;verticalAlign=top;spacingTop=12;fontStyle=1;fontSize=21;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="380" y="275" width="310" height="650" />
        </mxCell>
        <mxCell id="stage2" value="3  EX — Execute" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fef3c7;strokeColor=#475569;strokeWidth=2;fontSize=17;fontFamily=Arial;verticalAlign=top;spacingTop=12;fontStyle=1;fontSize=21;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="710" y="275" width="310" height="650" />
        </mxCell>
        <mxCell id="stage3" value="4  MEM / I/O access" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dcfce7;strokeColor=#475569;strokeWidth=2;fontSize=17;fontFamily=Arial;verticalAlign=top;spacingTop=12;fontStyle=1;fontSize=21;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1040" y="275" width="310" height="650" />
        </mxCell>
        <mxCell id="stage4" value="5  WB — Write back" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fce7f3;strokeColor=#475569;strokeWidth=2;fontSize=17;fontFamily=Arial;verticalAlign=top;spacingTop=12;fontStyle=1;fontSize=21;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1370" y="275" width="310" height="650" />
        </mxCell>
        <mxCell id="memory" value="Instruction Memory: 256 x 16&#10;Outside CPU core; inside FPGA PL&#10;Combinational instruction read" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#e0f2fe;strokeColor=#475569;strokeWidth=2;fontSize=17;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="65" y="35" width="520" height="115" />
        </mxCell>
        <mxCell id="pc" value="PC register&#10;8-bit instruction address" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#475569;strokeWidth=2;fontSize=17;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="90" y="365" width="230" height="90" />
        </mxCell>
        <mxCell id="next" value="Next-PC logic&#10;Take = jump OR (branch_z AND Z)&#10;Select target imm8 or PC+1&#10;PC+1 wraps modulo 256" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#475569;strokeWidth=2;fontSize=17;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="75" y="685" width="260" height="135" />
        </mxCell>
        <mxCell id="decode" value="Controller: field extraction&#10;and combinational opcode decode&#10;opcode / Rd / Rs / imm8" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#475569;strokeWidth=2;fontSize=17;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="405" y="360" width="260" height="110" />
        </mxCell>
        <mxCell id="rf" value="Register File R0–R3&#10;4 x 16 bits&#10;Read A = R[Rd], B = R[Rs]&#10;Write address = Rd" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#475569;strokeWidth=2;fontSize=17;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="405" y="545" width="260" height="115" />
        </mxCell>
        <mxCell id="imm" value="Zero-extend imm8 to 16 bits" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#475569;strokeWidth=2;fontSize=17;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="405" y="745" width="260" height="60" />
        </mxCell>
        <mxCell id="bmux" value="Operand B MUX&#10;B or zero-extended imm8" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#475569;strokeWidth=2;fontSize=17;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="735" y="480" width="260" height="75" />
        </mxCell>
        <mxCell id="alu" value="ALU&#10;PASS B / ADD / SUB&#10;AND / OR / XOR" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#475569;strokeWidth=2;fontSize=17;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="735" y="610" width="260" height="95" />
        </mxCell>
        <mxCell id="zero" value="Zero detection → Z register&#10;CMP: Z = (ALU result == 0)&#10;CMP does not write Rd" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#475569;strokeWidth=2;fontSize=17;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="735" y="770" width="260" height="90" />
        </mxCell>
        <mxCell id="ioif" value="CPU I/O interface&#10;io_addr[7:0] = port&#10;io_wdata[15:0] = R[Rs]&#10;io_re / io_we" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#475569;strokeWidth=2;fontSize=17;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1065" y="480" width="260" height="120" />
        </mxCell>
        <mxCell id="memnote" value="No LDR / STR in current ISA&#10;No ordinary data-memory access&#10;INP / OUP use GPIO peripheral" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f0fdf4;strokeColor=#475569;strokeWidth=2;fontSize=17;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1065" y="755" width="260" height="100" />
        </mxCell>
        <mxCell id="wb" value="Write-back MUX&#10;ALU result or io_rdata&#10;wb_sel" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#475569;strokeWidth=2;fontSize=17;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1395" y="610" width="260" height="100" />
        </mxCell>
        <mxCell id="commit" value="Write Rd when reg_write = 1&#10;INP: zero-extended GPIO value&#10;CMP / JUMP / JZ / OUP:&#10;no general-register write" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#475569;strokeWidth=2;fontSize=17;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1395" y="785" width="260" height="110" />
        </mxCell>
        <mxCell id="gpio" value="GPIO peripheral — outside CPU core; inside FPGA PL&#10;0x10 GPIO_OUT[7:0] / 0x11 GPIO_IN[7:0] / 0x12 GPIO_DIR[7:0]&#10;Port decoder, output/direction registers, input synchronizers and read MUX&#10;INP: io_rdata = {8'b0, selected 8-bit value}; OUP: use io_wdata[7:0]" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dcfce7;strokeColor=#475569;strokeWidth=2;fontSize=17;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="960" y="1110" width="720" height="140" />
        </mxCell>
        <mxCell id="pins" value="8 physical GPIO pins: gpio[7:0]&#10;Direction per pin: 0 = input, 1 = output; reset = all input" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dcfce7;strokeColor=#475569;strokeWidth=2;fontSize=17;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="995" y="1320" width="650" height="75" />
        </mxCell>
        <mxCell id="timing" value="ONE CLOCK PERIOD — functional regions, NOT pipeline stages&#10;Combinational processing during the period; PC, enabled GPR/Z and GPIO output/direction registers update at the closing rising edge.&#10;Not every instruction uses every region. Clock/reset distributed to all state registers (wires omitted)." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#475569;strokeWidth=2;fontSize=17;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="65" y="955" width="1595" height="75" />
        </mxCell>
        <mxCell id="legend" value="Control outputs (named at destinations): alu_src, alu_op, wb_sel, reg_write, z_write, jump, branch_z, io_re, io_we.&#10;Solid arrows: data/address or write-back path. Dashed arrows: grouped control/field routing. Instruction classes share the same hardware." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f1f5f9;strokeColor=#475569;strokeWidth=2;fontSize=17;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="65" y="1430" width="1615" height="70" />
        </mxCell>
