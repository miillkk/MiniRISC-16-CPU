0005 // 00: MOVI R0, #0x05
1400 // 01: MOVR R1, R0
2403 // 02: ADDI R1, #0x03
3100 // 03: ADDR R0, R1
4100 // 04: XOR  R0, R1
5100 // 05: SUB  R0, R1
7100 // 06: AND  R0, R1
9100 // 07: OR   R0, R1
6100 // 08: CMP  R0, R1             ; Z=1
800B // 09: JZ   #0x0B              ; taken
0CEE // 0A: MOVI R3, #0xEE          ; skipped
0801 // 0B: MOVI R2, #0x01
6900 // 0C: CMP  R2, R1             ; Z=0
800F // 0D: JZ   #0x0F              ; not taken
2801 // 0E: ADDI R2, #0x01
A011 // 0F: JUMP #0x11
0CDD // 10: MOVI R3, #0xDD          ; skipped
0CA5 // 11: MOVI R3, #0xA5
C310 // 12: OUP  0x10, R3           ; GPIO_OUT=0xA5
080F // 13: MOVI R2, #0x0F
C212 // 14: OUP  0x12, R2           ; GPIO_DIR=0x0F
D000 // 15: reserved opcode D
E000 // 16: reserved opcode E       ; input synchronizer settling
B011 // 17: INP  R0, 0x11           ; GPIO_IN=0xA5
04A5 // 18: MOVI R1, #0xA5
6100 // 19: CMP  R0, R1             ; Z=1
801C // 1A: JZ   #0x1C              ; taken
0CCC // 1B: MOVI R3, #0xCC          ; skipped
C010 // 1C: OUP  0x10, R0
F000 // 1D: reserved opcode F
1800 // 1E: MOVR R2, R0
A021 // 1F: JUMP #0x21
0CBB // 20: MOVI R3, #0xBB          ; skipped
A021 // 21: completion loop
