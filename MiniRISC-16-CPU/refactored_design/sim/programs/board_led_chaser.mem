@00
0001 // 00 MOVI R0, 01: first LED pattern
C030 // 01 OUP  30, R0

0C01 // 02 DELAY_START: MOVI R3, 01
04FF // 03 OUTER_INIT: MOVI R1, FF
08FF // 04 MIDDLE_INIT: MOVI R2, FF
00FF // 05 INNER_INIT: MOVI R0, FF
5300 // 06 INNER: SUB R0, R3
8009 // 07 JZ INNER_DONE
A006 // 08 JUMP INNER
5B00 // 09 INNER_DONE: SUB R2, R3
800C // 0A JZ MIDDLE_DONE
A005 // 0B JUMP INNER_INIT
5700 // 0C MIDDLE_DONE: SUB R1, R3
800F // 0D JZ DELAY_DONE
A004 // 0E JUMP MIDDLE_INIT

B030 // 0F DELAY_DONE: INP R0, 30: read current LED value
0480 // 10 MOVI R1, 80
6100 // 11 CMP  R0, R1: detect the 8-bit end before shifting
8016 // 12 JZ WRAP
3000 // 13 ADDR R0, R0: shift left by one
C030 // 14 OUP 30, R0
A002 // 15 JUMP DELAY_START
0001 // 16 WRAP: MOVI R0, 01
C030 // 17 OUP 30, R0
A002 // 18 JUMP DELAY_START
